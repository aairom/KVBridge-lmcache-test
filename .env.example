# KVBridge configuration. Copy to ".env" and adjust. Every value is optional.
#
# Priority (highest first):  GUI "Engine & Cache" tab  >  process environment  >  .env  >  defaults.
# The GUI can also write these values back to .env ("Save settings to .env").
# .env is git-ignored and may contain an API key: keep it private (chmod 600).

# ============================================================================
# 1. ENGINE SELECTION
# ============================================================================
# llamacpp  -> local llama-server, FULL integration (real KV save/restore)
# ollama    -> local Ollama, shadow mode
# cloud     -> any hosted OpenAI-compatible API, shadow mode (prompts leave this machine!)
KVB_ENGINE=llamacpp

# ============================================================================
# 2. LOCAL ENGINE: llama.cpp   (KVB_ENGINE=llamacpp)
# ============================================================================
# Path to a llama-server binary (empty = auto-detect: PATH, then the search paths below).
KVB_LLAMA_SERVER_BIN=
# Extra directories/files probed for llama-server, ":"-separated
# (empty = built-in defaults: /opt/homebrew/bin, /usr/local/bin, Ollama.app resources).
KVB_LLAMA_SEARCH_PATHS=
# URL of an already-running llama-server to attach to (empty = start a managed one).
KVB_LLAMA_URL=
# Seconds to wait for a managed llama-server to become healthy.
KVB_LLAMA_START_TIMEOUT=180
# Explicit GGUF path (empty = resolve the Ollama model's GGUF blob).
KVB_MODEL_PATH=
# Managed llama-server bind address / port.
KVB_MANAGED_HOST=127.0.0.1
KVB_MANAGED_PORT=8089
# Ports the managed server must never use (comma-separated; empty = no restriction).
KVB_RESERVED_PORTS=5000,8080,9931,11434
# -1 = llama.cpp default (offload everything it can).
KVB_N_GPU_LAYERS=-1
# llama.cpp's own host-RAM prompt cache in MiB (0 = disabled, keeps the demo honest).
KVB_CACHE_RAM_MB=0
# Extra llama-server flags, e.g. "--threads 8".
KVB_EXTRA_ARGS=

# ============================================================================
# 3. LOCAL ENGINE: Ollama   (KVB_ENGINE=ollama; its model also feeds llama.cpp)
# ============================================================================
KVB_OLLAMA_URL=http://127.0.0.1:11434
KVB_OLLAMA_MODEL=llama3.2:latest
# keep_alive sent to Ollama when the model is (re)loaded.
KVB_OLLAMA_KEEP_ALIVE=10m
# Where Ollama stores models (empty = $OLLAMA_MODELS or ~/.ollama/models).
KVB_OLLAMA_MODELS_DIR=

# ============================================================================
# 4. CLOUD ENGINE: OpenAI-compatible API   (KVB_ENGINE=cloud)
# ============================================================================
# WARNING: with this engine your prompts and documents are sent to the remote
# service and may be billed. Use a key with a spending limit.
#
# Provider preset (fills the base URL): openai, groq, openrouter, together,
# mistral, deepseek, vllm-local, lmstudio-local, ollama-local-openai.
KVB_CLOUD_PROVIDER=
# Base URL ending in /v1 (overrides the preset), e.g. https://api.openai.com/v1
KVB_CLOUD_BASE_URL=
KVB_CLOUD_MODEL=
# API key - NEVER commit it. Preferred: leave it empty here and name an
# environment variable that holds the key instead:
KVB_CLOUD_API_KEY=
KVB_CLOUD_API_KEY_ENV=
# Extra HTTP headers as a JSON object, e.g. {"HTTP-Referer": "https://example.com"}
KVB_CLOUD_EXTRA_HEADERS=
# "chat" (/chat/completions) or "completions" (/completions)
KVB_CLOUD_API_STYLE=chat
# Name of the max-tokens field (some APIs want max_completion_tokens).
KVB_CLOUD_MAX_TOKENS_FIELD=max_tokens
# Some reasoning models reject a temperature parameter: set to false.
KVB_CLOUD_SEND_TEMPERATURE=true
# Ask the provider to report token usage (and cached tokens) in the stream.
KVB_CLOUD_STREAM_USAGE=true
KVB_CLOUD_VERIFY_TLS=true
# Capacity accounting only: KV bytes per token (0 = unknown).
KVB_CLOUD_KV_BYTES_PER_TOKEN=0
# Soft cap on prompt tokens sent per connection (0 = unlimited). Protects your bill.
KVB_CLOUD_TOKEN_BUDGET=0

# ---- Example: hosted provider ---------------------------------------------
#   KVB_ENGINE=cloud
#   KVB_CLOUD_PROVIDER=openai
#   KVB_CLOUD_MODEL=gpt-4o-mini
#   KVB_CLOUD_API_KEY_ENV=OPENAI_API_KEY      # export OPENAI_API_KEY in your shell
#   KVB_CLOUD_TOKEN_BUDGET=200000
#
# ---- Example: no-cost smoke test against Ollama's OpenAI-compatible API ----
#   KVB_ENGINE=cloud
#   KVB_CLOUD_PROVIDER=ollama-local-openai
#   KVB_CLOUD_MODEL=llama3.2:latest

# ============================================================================
# 5. SHARED BY ALL ENGINES
# ============================================================================
KVB_REQUEST_TIMEOUT=300
# Sampling seed.
KVB_SEED=1
KVB_CTX_SIZE=8192

# ============================================================================
# 6. KV CACHE LAYER
# ============================================================================
# Tokens per chunk (LMCache default: 256).
KVB_CHUNK_SIZE=256
# Tier capacities in MiB: L1 = RAM, L2 = local disk.
KVB_L1_MB=2048
KVB_L2_MB=8192
# Write new chunks to L2 immediately (survives restarts).
KVB_WRITE_THROUGH=true
# Use the real `lmcache` TokenHasher when installed (see scripts/install_lmcache.sh).
KVB_USE_LMCACHE_HASHER=false

# ---- Folders (defaults live under the project root) -----------------------
# KVB_STORE_DIR=
# KVB_SLOT_DIR=
# KVB_LOG_DIR=
# KVB_INPUT_DIR=
# KVB_OUTPUT_DIR=

# ============================================================================
# 7. GENERATION / GUI
# ============================================================================
KVB_N_PREDICT=48
KVB_TEMPERATURE=0.2
KVB_GUI_HOST=127.0.0.1
KVB_GUI_PORT=7871
